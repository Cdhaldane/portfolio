# Frontend (Create React App) — must be prefixed with REACT_APP_
# (EmailJS is no longer used by the contact form — kept only if other code needs it)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Contact form — SMTP for /api/contact.js (set real values in .env.local
# for `vercel dev`, and in the Vercel dashboard for production)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=

# Backend / Vercel serverless functions
# Postgres connection string (e.g. Vercel Postgres / Neon). Optional — the
# inquiry endpoint degrades gracefully and still returns success if unset.
POSTGRES_URL=

# Hidden /dashboard gate (/api/dashboard-access.js)
# Passcode for the dashboard. Defaults to "cat" if unset.
DASHBOARD_PASSWORD=cat
# Comma-separated IPs that skip the passcode entirely. Load /dashboard once and
# the lock screen shows your detected IP — paste it here (set in the Vercel
# dashboard for prod). e.g. "203.0.113.5, 2001:db8::1"
DASHBOARD_ALLOWED_IPS=

# Private /budgetter (Clerk auth — create the app at clerk.com with
# SIGN-UPS DISABLED and add the ~5 accounts by hand in its dashboard).
# Frontend key (safe to expose; CRA inlines it at build time):
REACT_APP_CLERK_PUBLISHABLE_KEY=
# Server-side key for /api/budget/* token verification — keep secret:
CLERK_SECRET_KEY=
# Fail-closed allowlist: comma-separated Clerk user ids. Unset = nobody gets
# in. A signed-in but unlisted user sees their own id on the page — paste it
# here. e.g. "user_2abc..., user_2def..."
BUDGET_ALLOWED_USER_IDS=

# Bill reminder emails (/api/budget/reminders, daily Vercel cron at 12:00 UTC).
# CRON_SECRET authenticates the cron — Vercel sends it automatically as a
# Bearer token once set in the dashboard. Unset = reminders disabled (503).
# Generate (works on Windows, no openssl needed):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
# Days before the due date to send (default 3); timezone anchor for "today".
REMINDER_DAYS_AHEAD=3
REMINDER_TZ=America/Toronto
