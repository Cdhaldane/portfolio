# Frontend (Create React App) — must be prefixed with REACT_APP_
# (EmailJS is no longer used by the contact form — kept only if other code needs it)
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Contact form — SMTP for /api/contact.js (set real values in .env.local
# for `vercel dev`, and in the Vercel dashboard for production)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=

# Backend / Vercel serverless functions
# Postgres connection string (e.g. Vercel Postgres / Neon). Optional — the
# inquiry endpoint degrades gracefully and still returns success if unset.
POSTGRES_URL=

# Hidden /dashboard gate (/api/dashboard-access.js)
# Passcode for the dashboard. Defaults to "cat" if unset.
DASHBOARD_PASSWORD=cat
# Comma-separated IPs that skip the passcode entirely. Load /dashboard once and
# the lock screen shows your detected IP — paste it here (set in the Vercel
# dashboard for prod). e.g. "203.0.113.5, 2001:db8::1"
DASHBOARD_ALLOWED_IPS=
